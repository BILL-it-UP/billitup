# Copy this file to ".env" (same folder) and adjust as needed.
# ".env" is gitignored and won't be touched by future update zips.

# IMPORTANT — read this if you've ever had your data (logins, invoices,
# customers) disappear after installing a new BillItUp update:
#
# By default the database lives at server/data/billitup.sqlite, INSIDE the
# folder that gets overwritten every time you extract a new update zip.
# Depending on how your zip tool handles an existing folder, that can wipe
# your data along with the update.
#
# The fix: point BILLITUP_DB_PATH somewhere OUTSIDE this project folder —
# somewhere that never gets touched by extracting a new zip. For example,
# on Windows:
#
# BILLITUP_DB_PATH=C:\BillItUpData\billitup.sqlite
#
# The folder will be created automatically if it doesn't exist yet.
# Once you set this and restart the server, your data lives there permanently
# — future updates will never affect it.

BILLITUP_DB_PATH=C:\BillItUpData\billitup.sqlite

# JWT_SECRET signs everyone's login tokens. If you don't set this, the server
# still runs fine for a quick local trial (it generates a random one on every
# start), but that means everyone gets logged out on every restart, and if
# you ever run more than one server instance they won't accept each other's
# tokens. Set this to any long random string before relying on this for real
# use — anything works, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# APP_URL is where your BillItUp client is actually reachable — used to build
# the link inside password-reset emails. Defaults to http://localhost:5173
# (only correct for local development). Set this to your real domain once
# you're online, e.g.:
# APP_URL=https://billitup.in
APP_URL=
